# Railbound Battle Royale - Environment Configuration
# Project Root: D:\MyProjects\railbound-asset-portal
#
# The backend reads these as environment variables (see backend/src/main/resources/application.yml).
# Defaults exist for local development; in production set every secret explicitly and run with
# SPRING_PROFILES_ACTIVE=prod. NEVER commit real keys.

# Application Ports
SERVER_PORT=8080
FRONTEND_PORT=3000

# MongoDB Configuration (D: Drive Single-Node Replica Set)
SPRING_DATA_MONGODB_URI=mongodb://127.0.0.1:27018/railbound_portal?replicaSet=rs0
MONGODB_DB_PATH=D:\MyProjects\railbound-asset-portal\local-data\mongo
MONGODB_LOG_PATH=D:\MyProjects\railbound-asset-portal\local-logs\mongod.log

# Security & Tokens (change all of these outside local development)
JWT_SECRET=railbound-tactical-jwt-secret-key-32-chars-minimum-battle-royale-portal
INTERNAL_SERVICE_KEY=svc_internal_railbound_secret_key_8829
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
AUTH_MOCK_TOKEN_ENABLED=true

# Payment providers
PAYMENT_DEFAULT_PROVIDER=mock
# Mock provider (development only - set PAYMENT_MOCK_ENABLED=false in production)
PAYMENT_MOCK_ENABLED=true
MOCK_GATEWAY_SECRET=mock_webhook_secret_key_99182
GATEWAY_CHECKOUT_BASE_URL=http://localhost:3000/checkout/hosted-mock

# PayHere (https://www.payhere.lk) - see docs/PAYHERE_SETUP.md
PAYHERE_ENABLED=false
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public URL PayHere calls with payment notifications (use a tunnel such as ngrok in development)
PAYHERE_NOTIFY_URL=

# Game Integration (Nakama)
NAKAMA_HOST=127.0.0.1
NAKAMA_PORT=7350
NAKAMA_SERVER_KEY=defaultkey
# Same value as Nakama's session.encryption_key; enables POST /api/v1/auth/nakama-login
NAKAMA_SESSION_ENCRYPTION_KEY=
