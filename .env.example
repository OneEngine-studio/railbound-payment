# Railbound Battle Royale - Environment Configuration
# Project Root: D:\MyProjects\railbound-asset-portal
# Copy this file to `.env` (never commit real secrets).

# ---------------------------------------------------------------------------
# Application Ports / URLs
# ---------------------------------------------------------------------------
SERVER_PORT=8080
FRONTEND_PORT=3000

# Public origin PayHere can reach for notify_url. PayHere cannot call localhost.
# Local testing: run a tunnel (e.g. `cloudflared tunnel --url http://localhost:8080`)
# and put the HTTPS URL here.
PAYMENT_PUBLIC_BASE_URL=http://localhost:8080
PAYMENT_FRONTEND_BASE_URL=http://localhost:3000
PAYMENT_DEFAULT_PROVIDER=payhere

# Comma-separated browser origins allowed to call the API. Add the production
# portal origin (must match the PayHere-registered domain).
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# MongoDB (D: Drive Single-Node Replica Set)
# ---------------------------------------------------------------------------
SPRING_DATA_MONGODB_URI=mongodb://127.0.0.1:27018/railbound_portal?replicaSet=rs0
MONGODB_DB_PATH=D:\MyProjects\railbound-asset-portal\local-data\mongo
MONGODB_LOG_PATH=D:\MyProjects\railbound-asset-portal\local-logs\mongod.log

# ---------------------------------------------------------------------------
# Security & Tokens
# ---------------------------------------------------------------------------
JWT_SECRET=railbound-tactical-jwt-secret-key-32-chars-minimum-battle-royale-portal
INTERNAL_SERVICE_KEY=svc_internal_railbound_secret_key_8829

# ---------------------------------------------------------------------------
# PayHere Checkout API (REQUIRED for real payments)
# Portal > Integrations > Add Domain/App. The Merchant Secret is domain-specific.
# Sandbox test cards: https://support.payhere.lk/sandbox-and-testing
# ---------------------------------------------------------------------------
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=USD

# ---------------------------------------------------------------------------
# PayHere Merchant API (reconciliation + refunds; optional but recommended)
# Portal > Settings > API Keys > Create API Key. Tick "Automated Charging API".
# The App ID / App Secret are NOT the same as the Checkout merchant secret.
# ---------------------------------------------------------------------------
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# ---------------------------------------------------------------------------
# Mock provider (local development/tests only - never enable in production)
# ---------------------------------------------------------------------------
APP_PAYMENT_MOCK_ENABLED=false
MOCK_GATEWAY_SECRET=mock_webhook_secret_key_99182
GATEWAY_CHECKOUT_BASE_URL=http://localhost:3000/checkout/hosted-mock

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PAYMENT_PROVIDER=payhere
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=false

# ---------------------------------------------------------------------------
# Game Integration (Nakama)
# ---------------------------------------------------------------------------
NAKAMA_HOST=127.0.0.1
NAKAMA_PORT=7350
NAKAMA_SERVER_KEY=defaultkey
